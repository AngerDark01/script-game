"""
地图拼接器 - 优化版
核心优化：
1. 结合stitcher_fixed.py的修复
2. 保持与现有系统的兼容性
3. 提升性能和准确性
4. 优化内存使用和处理速度
"""

import cv2
import numpy as np
from collections import deque


class MapStitcher:
    """实时地图拼接器 - 优化版"""

    def __init__(self, canvas_size=6000):
        """
        初始化

        Args:
            canvas_size: 画布大小（正方形）
        """
        self.canvas_size = canvas_size

        # 全局画布（只保存纯墙体）
        self.canvas = np.zeros((canvas_size, canvas_size), dtype=np.uint8)
        self.wall_layer = np.zeros((canvas_size, canvas_size), dtype=np.uint8)
        self.fog_layer = np.zeros((canvas_size, canvas_size), dtype=np.uint8)
        self.explored_map = np.zeros((canvas_size, canvas_size), dtype=np.uint8)

        # 当前位置（画布中心）
        self.current_x = canvas_size // 2
        self.current_y = canvas_size // 2

        # 历史帧（用于配准）
        self.prev_frame = None
        self.frame_history = deque(maxlen=10)

        # 位移平滑（避免抖动）
        self.smooth_dx = 0.0
        self.smooth_dy = 0.0
        self.alpha = 0.7  # 平滑系数（0.7 = 30%新值 + 70%旧值）

        # 统计信息
        self.stats = {
            'total_frames': 0,
            'successful_matches': 0,
            'failed_matches': 0,
            'match_quality': 0.0,
            'avg_displacement': []
        }

        # 上一次绘制时的位置（用于控制绘制频率）
        self.last_draw_x = self.current_x
        self.last_draw_y = self.current_y

    def add_frame(self, img, match_mask, save_mask, fog_mask, raw_gray=None, player_pos=None):
        """
        ⭐ 优化版：添加新帧到地图

        使用相位相关法 + 最优缝合线

        Args:
            img: 原始BGR图像
            match_mask: 用于配准的mask（墙体+边缘增强）
            save_mask: 用于保存的mask（纯墙体二值化）
            fog_mask: 迷雾层mask
            raw_gray: 原始灰度图（已废弃，保留兼容性）
            player_pos: 玩家在当前帧中的局部坐标 (px, py)，如果为None则假设在中心

        Returns:
            bool: 是否成功拼接
        """
        self.stats['total_frames'] += 1

        h, w = save_mask.shape

        # 确定玩家在当前帧的位置
        if player_pos is None:
            px, py = w // 2, h // 2
        else:
            px, py = player_pos

        # 第一帧：直接放置
        if self.prev_frame is None:
            self._place_first_frame(save_mask, fog_mask, px, py)
            self.prev_frame = match_mask.copy()
            return True

        # ⭐ 使用相位相关法计算位移
        displacement, quality = self._estimate_displacement_phase_correlation(
            self.prev_frame,
            match_mask
        )
        
        # 强制打印调试信息用于分析漂移问题
        if displacement:
            dx_debug, dy_debug = displacement
            print(f"[DRIFT_DEBUG] Quality: {quality:.4f} | Raw Shift: dx={dx_debug:.4f}, dy={dy_debug:.4f}")
        else:
            print(f"[DRIFT_DEBUG] Match Failed! Quality: {quality:.4f}")

        self.stats['match_quality'] = quality

        # 判断是否成功匹配
        if displacement is not None and quality > 0.15:
            dx, dy = displacement

            # 调试日志：打印计算出的位移和质量
            # print(f"[DEBUG] dx={dx:.2f}, dy={dy:.2f}, quality={quality:.4f}")

            # 死区过滤：忽略极微小的抖动（静止时的噪声）
            # 提高死区阈值：从 1.0 提高到 3.0，因为日志显示有偶发的 -2.0~-2.4 的跳动
            if abs(dx) < 3.0 and abs(dy) < 3.0:
                # print("[DEBUG] 位移过小，视为静止")
                dx, dy = 0.0, 0.0
            
            # 如果判定为静止，直接返回True但不更新位置（避免累积浮点误差）
            if dx == 0.0 and dy == 0.0:
                 return True

            # 计算当前全局位置
            # 如果图像向右移动了 dx (dx > 0)，说明相机（玩家）向左移动了，所以玩家位置应该是 current_x - dx
            target_x = self.current_x - dx
            target_y = self.current_y - dy

            # 位移限制（防止跳跃）
            max_shift = min(h, w) * 0.5
            if abs(dx) > max_shift or abs(dy) > max_shift:
                print(f"⚠️ 位移过大: ({dx:.1f}, {dy:.1f}), 跳过此帧")
                self.stats['failed_matches'] += 1
                return False

            # 直接更新位置（移除平滑，避免漂移）
            # 平滑会导致累积误差：target_x = current_x - dx
            # 如果使用平滑：new_x = alpha * current + (1-alpha) * (current - dx) = current - (1-alpha)*dx
            # 这意味着我们丢失了 alpha (70%) 的位移！
            self.current_x = target_x
            self.current_y = target_y

            # 移除平滑变量的更新（不再需要）
            # self.smooth_dx = dx
            # self.smooth_dy = dy

            # 记录位移
            disp_mag = np.sqrt(dx**2 + dy**2)
            self.stats['avg_displacement'].append(disp_mag)
            if len(self.stats['avg_displacement']) > 100:
                self.stats['avg_displacement'].pop(0)

            # ⭐ 智能绘制控制
            # 计算自上次绘制以来的累积位移
            dist_since_draw = np.sqrt((self.current_x - self.last_draw_x)**2 + 
                                    (self.current_y - self.last_draw_y)**2)

            # 阈值策略：
            # 1. 20.0像素：大幅减少绘制频率，解决墙体变厚和毛躁问题
            # 2. 前5帧：强制绘制，确保初始画面完整
            if dist_since_draw > 20.0 or self.stats['total_frames'] < 5:
                # 使用智能增量融合
                success = self._place_frame_smart_merge(save_mask, fog_mask, h, w, px, py)
                
                if success:
                    self.stats['successful_matches'] += 1
                    # 只有绘制成功才更新“上次绘制位置”
                    self.last_draw_x = self.current_x
                    self.last_draw_y = self.current_y
            
            # 无论是否绘制，都要更新 prev_frame 以保持追踪连续性
            self.prev_frame = match_mask.copy()
            return True

        self.stats['failed_matches'] += 1
        return False

    def _estimate_displacement_phase_correlation(self, prev_mask, curr_mask):
        """
        ⭐ 相位相关法（游戏地图最佳算法）

        优点：
        - 速度极快（5-10ms）
        - 对重复纹理不敏感（墙体都很像）
        - 亚像素精度
        - 不受光照影响

        Args:
            prev_mask: 前一帧mask
            curr_mask: 当前帧mask

        Returns:
            ((dx, dy), quality) 或 (None, 0.0)
        """
        try:
            # 汉宁窗（减少边界效应）
            h, w = prev_mask.shape
            hann_window = cv2.createHanningWindow((w, h), cv2.CV_32F)

            # ⭐ 相位相关计算
            shift, response = cv2.phaseCorrelate(
                prev_mask.astype(np.float32),
                curr_mask.astype(np.float32),
                window=hann_window
            )

            dx, dy = shift
            quality = float(response)

            # 有效性检查
            if np.isnan(dx) or np.isnan(dy) or np.isinf(dx) or np.isinf(dy):
                return None, 0.0

            return (dx, dy), quality

        except Exception as e:
            print(f"相位相关计算失败: {e}")
            return None, 0.0

    def _place_first_frame(self, save_mask, fog_mask, px, py):
        """放置第一帧"""
        h, w = save_mask.shape

        cur_x = int(self.current_x)
        cur_y = int(self.current_y)
        
        # 初始化上次绘制位置
        self.last_draw_x = self.current_x
        self.last_draw_y = self.current_y

        # 根据玩家在局部图像中的位置 (px, py) 计算图像左上角的放置位置
        # 图像左上角在全局坐标系中的位置 = 全局玩家位置 - 局部玩家位置
        x1 = cur_x - px
        y1 = cur_y - py
        x2 = x1 + w
        y2 = y1 + h

        if self._check_bounds(x1, y1, x2, y2):
            # ⭐ 只保存纯墙体
            self.canvas[y1:y2, x1:x2] = save_mask
            self.wall_layer[y1:y2, x1:x2] = save_mask
            self.fog_layer[y1:y2, x1:x2] = fog_mask
            self.explored_map[y1:y2, x1:x2] = 255

            self.stats['successful_matches'] += 1

    def _place_frame_smart_merge(self, save_mask, fog_mask, h, w, px, py):
        """
        ⭐ 智能增量融合（只绘制新增区域，完美解决重叠变厚和抖动）

        策略：
        1. 仅在“未探索区域”或“迷雾区域”写入新内容
        2. 对于已存在的墙体，完全保留（忽略新帧的微小位移/抖动）
        3. 消除重叠区域的重复绘制，防止墙体变厚

        Args:
            save_mask: 纯墙体mask
            fog_mask: 迷雾mask
            h, w: 帧尺寸
            px, py: 玩家在局部图像中的坐标

        Returns:
            bool: 是否成功
        """
        cur_x = int(self.current_x)
        cur_y = int(self.current_y)

        # 计算放置位置
        x1 = cur_x - px
        y1 = cur_y - py
        x2 = x1 + w
        y2 = y1 + h

        # 边界检查
        if not self._check_bounds(x1, y1, x2, y2):
            return False

        # 获取各层ROI
        roi_wall = self.wall_layer[y1:y2, x1:x2]
        roi_fog = self.fog_layer[y1:y2, x1:x2]
        roi_explored = self.explored_map[y1:y2, x1:x2]

        # ---------------------------------------------------------
        # ⭐ 核心逻辑：计算“允许更新掩膜” (Update Mask)
        # ---------------------------------------------------------
        
        # 1. 未探索区域：永远允许更新
        mask_unvisited = (roi_explored == 0)

        # 2. 迷雾区域且无墙体：允许更新（迷雾消散发现新墙，或迷雾变空地）
        # 注意：如果原本就有墙，即使有迷雾也不允许更新（保护现有墙体不被漂移破坏）
        mask_foggy_update = (roi_fog > 50) & (roi_wall < 50)

        # 综合更新掩膜
        mask_update = mask_unvisited | mask_foggy_update

        # ---------------------------------------------------------
        # 执行融合
        # ---------------------------------------------------------
        
        # 1. 更新墙体层 (只在允许区域写入)
        # 使用 cv2.bitwise_or 还是直接赋值？
        # 直接赋值更干脆：如果是新墙就覆盖，如果是变空地也覆盖
        # 但为了防止噪点挖空，我们可以只允许 "写入墙体" 或 "写入空地"?
        # 简单策略：直接拷贝 mask_update 区域的像素
        if np.any(mask_update):
            # 只有在 mask_update 为 True 的地方，才使用 save_mask 的值
            # 其它地方保持原样 (roi_wall)
            
            # 优化：为了防止边缘锯齿，我们在 mask_update 边缘做一点羽化？
            # 不，用户要的是锐利。直接硬替换。
            
            # 利用 numpy 索引更新
            roi_wall[mask_update] = save_mask[mask_update]
            
            # 2. 更新迷雾层
            # 迷雾层比较特殊，我们总是取最大值？还是也只更新新增？
            # 如果迷雾消散了（新帧fog=0），我们应该清除迷雾
            roi_fog[mask_update] = fog_mask[mask_update]
            
            # 3. 更新探索状态
            roi_explored[mask_update] = 255

            # 写回全局画布
            self.wall_layer[y1:y2, x1:x2] = roi_wall
            self.fog_layer[y1:y2, x1:x2] = roi_fog
            self.explored_map[y1:y2, x1:x2] = roi_explored
            self.canvas[y1:y2, x1:x2] = roi_wall # 显示层

        return True

    def _blend_with_seam(self, img1, img2, seam):
        """
        [已废弃] 按缝合线融合（只保留一侧，完全消除残影）
        """
        pass

    def _find_optimal_seam(self, img1, img2, overlap_mask):
        """
        [已废弃] 基于能量图的最优缝合线（动态规划）
        """
        pass

    def _dp_seam(self, energy):
        """
        [已废弃] 动态规划找最小能量缝合线
        """
        pass

    def _check_bounds(self, x1, y1, x2, y2):
        """检查是否在画布范围内"""
        return (0 <= x1 < self.canvas_size and
                0 <= y1 < self.canvas_size and
                0 < x2 <= self.canvas_size and
                0 < y2 <= self.canvas_size)

    def get_current_position(self):
        """获取当前位置"""
        return (int(self.current_x), int(self.current_y))

    def get_cropped_map(self, margin=500):
        """
        获取裁剪后的地图（去除空白）

        Args:
            margin: 边缘留白像素

        Returns:
            裁剪后的地图
        """
        coords = cv2.findNonZero(self.canvas)

        if coords is None:
            center = self.canvas_size // 2
            return self.canvas[center-200:center+200, center-200:center+200]

        x, y, w, h = cv2.boundingRect(coords)

        x1 = max(0, x - margin)
        y1 = max(0, y - margin)
        x2 = min(self.canvas_size, x + w + margin)
        y2 = min(self.canvas_size, y + h + margin)

        return self.canvas[y1:y2, x1:x2]

    def get_enhanced_map(self, margin=500):
        """
        获取增强后的地图（纯墙体，无纹理）

        Args:
            margin: 边缘留白

        Returns:
            enhanced_map: 增强后的地图图像
        """
        coords = cv2.findNonZero(self.canvas)

        if coords is None:
            return self.canvas.copy()

        x, y, w, h = cv2.boundingRect(coords)
        x1 = max(0, x - margin)
        y1 = max(0, y - margin)
        x2 = min(self.canvas_size, x + w + margin)
        y2 = min(self.canvas_size, y + h + margin)

        # 提取墙体层
        roi_wall = self.wall_layer[y1:y2, x1:x2]

        # 纯黑背景 + 纯白墙体
        _, walls_enhanced = cv2.threshold(roi_wall, 127, 255, cv2.THRESH_BINARY)

        return walls_enhanced

    def get_statistics(self):
        """获取统计信息"""
        match_rate = (self.stats['successful_matches'] / max(1, self.stats['total_frames'])) * 100

        avg_disp = 0.0
        if self.stats['avg_displacement']:
            avg_disp = np.mean(self.stats['avg_displacement'])

        explored = np.count_nonzero(self.explored_map)
        total = self.canvas_size * self.canvas_size
        exploration = (explored / total) * 100

        return {
            'total_frames': self.stats['total_frames'],
            'successful_matches': self.stats['successful_matches'],
            'failed_matches': self.stats['failed_matches'],
            'match_rate': match_rate,
            'match_quality': self.stats['match_quality'],
            'avg_displacement': avg_disp,
            'exploration': exploration
        }

    def reset(self):
        """重置地图"""
        self.canvas = np.zeros((self.canvas_size, self.canvas_size), dtype=np.uint8)
        self.wall_layer = np.zeros((self.canvas_size, self.canvas_size), dtype=np.uint8)
        self.fog_layer = np.zeros((self.canvas_size, self.canvas_size), dtype=np.uint8)
        self.explored_map = np.zeros((self.canvas_size, self.canvas_size), dtype=np.uint8)

        self.current_x = self.canvas_size // 2
        self.current_y = self.canvas_size // 2

        self.prev_frame = None
        self.frame_history.clear()

        self.smooth_dx = 0.0
        self.smooth_dy = 0.0

        self.stats = {
            'total_frames': 0,
            'successful_matches': 0,
            'failed_matches': 0,
            'match_quality': 0.0,
            'avg_displacement': []
        }