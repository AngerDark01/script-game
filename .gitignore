# Probe/debug outputs are generated locally and can be very large.
# Keep reusable probe scripts under tools/ tracked, but ignore their
# timestamped screenshots, reports, and evaluation directories.
data/diagnostics/
tools/debug/*/
tools/debug/*.png
tools/debug/*.json
data/maps/**/config.before_apply_*.json

# Explicitly installed local ONNX OCR models; the source-controlled manifest
# lives in src/auto_modules/core/perception/providers/rapidocr_models.py instead.
resources/assets/perception_models/

